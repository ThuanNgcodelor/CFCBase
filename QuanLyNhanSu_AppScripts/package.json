{
  "name": "cfc-hr-appscript-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node src/client/build/inlineHtml.mjs",
    "build:workspace": "node ../frontend/node_modules/vite/bin/vite.js build && node src/client/build/inlineHtml.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "npm run build:workspace && npm run build:server && npm run verify",
    "check:server": "node scripts/check-server.mjs",
    "check:client-imports": "node scripts/check-client-imports.mjs",
    "test:server": "node tests/server/foundation.test.cjs",
    "verify": "node scripts/verify-dist.mjs",
    "check": "npm run check:server && npm run check:client-imports && npm run test:server && npm run build:all",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "vite": "^8.1.1"
  }
}
